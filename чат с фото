<!DOCTYPE html>
<html>
<head>
    <title>Мессенджер</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        :root {
            --bg: #f0f0f0;
            --surface: #ffffff;
            --text: #333333;
            --sub: #666666;
            --primary: #0084ff;
            --border: #dddddd;
            --msg-bg: #0084ff;
            --msg-text: #ffffff;
            --reply-bg: rgba(0,0,0,0.05);
        }
        .dark {
            --bg: #1a1a2e;
            --surface: #16213e;
            --text: #e0e0e0;
            --sub: #aaaaaa;
            --primary: #1a4a7a;
            --border: #2a2a4a;
            --msg-bg: #1a4a7a;
            --msg-text: #e0e0e0;
            --reply-bg: rgba(255,255,255,0.05);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .screen { display: none; flex-direction: column; height: 100vh; }
        .screen.active { display: flex; }

        /* ВХОД */
        #login-screen { justify-content: center; align-items: center; background: #0084ff; }
        #login-screen .box { background: white; padding: 30px; border-radius: 15px; text-align: center; width: 85%; max-width: 350px; }
        #login-screen h1 { margin-bottom: 20px; color: #333; }
        #login-screen input { width: 100%; padding: 12px; margin: 8px 0; border: 1px solid #ddd; border-radius: 10px; font-size: 16px; }
        #login-screen button { width: 100%; padding: 12px; margin-top: 10px; background: #0084ff; color: white; border: none; border-radius: 10px; font-size: 18px; font-weight: bold; }

        /* ШАПКА */
        .header { background: var(--primary); color: white; padding: 15px; display: flex; justify-content: space-between; align-items: center; }
        .header button { background: rgba(255,255,255,0.2); color: white; border: none; padding: 8px 15px; border-radius: 20px; font-size: 14px; }

        /* СПИСОК ЧАТОВ */
        #chats-list { flex: 1; overflow-y: auto; padding: 10px; }
        .chat-item { background: var(--surface); padding: 15px; border-radius: 10px; margin-bottom: 8px; display: flex; align-items: center; gap: 10px; }
        .chat-item .icon { font-size: 30px; }
        .chat-item .name { font-weight: bold; }

        #chat-actions { display: flex; padding: 10px; background: var(--surface); border-top: 1px solid var(--border); gap: 10px; }
        #chat-actions input { flex: 1; padding: 12px; border: 1px solid var(--border); border-radius: 10px; font-size: 14px; background: var(--bg); color: var(--text); }
        #chat-actions button { padding: 12px 15px; background: var(--primary); color: white; border: none; border-radius: 10px; font-weight: bold; font-size: 13px; }

        /* ПРОФИЛЬ */
        #profile-screen .content { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 30px; background: var(--bg); }
        #avatar-img { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; background: #ddd; margin-bottom: 15px; }
        #profile-screen input[type="text"] { padding: 10px; font-size: 16px; margin: 10px 0; border: 1px solid var(--border); border-radius: 10px; width: 80%; background: var(--surface); color: var(--text); }
        #profile-screen button { padding: 10px 20px; background: var(--primary); color: white; border: none; border-radius: 10px; margin: 5px; }
        #avatar-file { display: none; }
        .setting-row { display: flex; justify-content: space-between; align-items: center; width: 80%; padding: 15px; background: var(--surface); border-radius: 10px; margin: 10px 0; }
        .setting-row span { color: var(--text); }
        .toggle { width: 50px; height: 26px; background: #ccc; border-radius: 13px; position: relative; cursor: pointer; }
        .toggle.active { background: #0084ff; }
        .toggle::after { content: ''; width: 22px; height: 22px; background: white; border-radius: 50%; position: absolute; top: 2px; left: 2px; transition: 0.2s; }
        .toggle.active::after { left: 26px; }

        /* ЧАТ */
        #messages { flex: 1; padding: 10px; overflow-y: auto; }
        .message-row { display: flex; gap: 8px; align-items: flex-end; margin: 5px 0; cursor: pointer; }
        .message-row .msg-avatar { width: 25px; height: 25px; border-radius: 50%; object-fit: cover; background: #ddd; flex-shrink: 0; }
        .message { background: var(--msg-bg); color: var(--msg-text); padding: 10px 15px; border-radius: 20px; max-width: 70%; word-wrap: break-word; }
        .message .sender { font-size: 11px; opacity: 0.7; margin-bottom: 3px; }
        .message .reply-preview { font-size: 11px; background: var(--reply-bg); padding: 4px 8px; border-radius: 8px; margin-bottom: 5px; border-left: 3px solid rgba(255,255,255,0.4); }
        .message img { max-width: 200px; border-radius: 10px; margin-top: 5px; }
        .reply-bar { display: flex; padding: 8px 15px; background: var(--surface); border-top: 1px solid var(--border); gap: 10px; align-items: center; }
        .reply-bar .reply-text { flex: 1; font-size: 12px; color: var(--sub); }
        .reply-bar button { background: none; border: none; color: red; font-size: 18px; cursor: pointer; }
        .input-area { display: flex; padding: 10px; background: var(--surface); border-top: 1px solid var(--border); gap: 10px; }
        .input-area input { flex: 1; padding: 12px 15px; font-size: 16px; border: 1px solid var(--border); border-radius: 25px; outline: none; background: var(--bg); color: var(--text); }
        .input-area button { padding: 12px 25px; font-size: 16px; background: var(--primary); color: white; border: none; border-radius: 25px; font-weight: bold; }
        .input-area .attach-btn { padding: 12px 15px; font-size: 20px; background: none; border: none; cursor: pointer; }
        #photo-input { display: none; }
    </style>
</head>
<body>

    <div id="login-screen" class="screen active">
        <div class="box">
            <h1>🔐 Вход</h1>
            <input type="text" id="login-nick" placeholder="Придумай никнейм">
            <input type="password" id="login-pass" placeholder="Придумай пароль">
            <button id="login-btn">Войти</button>
        </div>
    </div>

    <div id="chats-screen" class="screen">
        <div class="header">
            <span>💬 Мессенджер</span>
            <button id="to-profile-btn">Профиль</button>
        </div>
        <div id="chats-list">Загрузка...</div>
        <div id="chat-actions">
            <input type="text" id="new-chat-name" placeholder="Название чата...">
            <button id="join-chat-btn">Войти</button>
        </div>
    </div>

    <div id="chat-room-screen" class="screen">
        <div class="header">
            <button id="back-btn">← Назад</button>
            <span id="chat-room-title">Чат</span>
            <span></span>
        </div>
        <div id="messages"></div>
        <div id="reply-bar" class="reply-bar" style="display:none;">
            <span class="reply-text" id="reply-text"></span>
            <button id="cancel-reply-btn">✕</button>
        </div>
        <div class="input-area">
            <button class="attach-btn" id="attach-btn">📎</button>
            <input type="file" id="photo-input" accept="image/*">
            <input type="text" id="msg-input" placeholder="Сообщение...">
            <button id="send-btn">Отправить</button>
        </div>
    </div>

    <div id="profile-screen" class="screen">
        <div class="header">
            <button id="profile-back-btn">← Назад</button>
            <span>Профиль</span>
            <button id="logout-btn">Выйти</button>
        </div>
        <div class="content">
            <img id="avatar-img" src="" alt="Аватар" onclick="document.getElementById('avatar-file').click()">
            <input type="file" id="avatar-file" accept="image/*">
            <p style="font-size:12px;color:var(--sub);">Нажми на аватар чтобы сменить</p>
            <p id="profile-nick" style="font-weight:bold;font-size:18px;"></p>
            <input type="text" id="new-nick" placeholder="Новый никнейм">
            <button id="save-nick-btn">Сохранить ник</button>
            <div class="setting-row">
                <span>Тёмная тема</span>
                <div class="toggle" id="theme-toggle"></div>
            </div>
        </div>
    </div>

    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>
    <script>
        const firebaseConfig = {
            apiKey: "AIzaSyB4mdYi6d5_yWMeqf9SwRDuqMpLW7vseR8",
            authDomain: "website-9442c.firebaseapp.com",
            projectId: "website-9442c",
            storageBucket: "website-9442c.firebasestorage.app",
            messagingSenderId: "490236144166",
            appId: "1:490236144166:web:2651f3bc8a0a719e85d4e7",
            measurementId: "G-B2WHYMXE8K"
        };

        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        let currentUser = null;
        let currentChatId = null;
        let replyTo = null;

        // ТЁМНАЯ ТЕМА
        if (localStorage.getItem('dark') === 'true') {
            document.body.classList.add('dark');
        }
        document.getElementById('theme-toggle').onclick = function() {
            document.body.classList.toggle('dark');
            localStorage.setItem('dark', document.body.classList.contains('dark'));
            this.classList.toggle('active', document.body.classList.contains('dark'));
        };
        document.getElementById('theme-toggle').classList.toggle('active', document.body.classList.contains('dark'));

        // ВХОД
        let savedUser = localStorage.getItem('currentUser');
        if (savedUser) {
            currentUser = JSON.parse(savedUser);
            showScreen('chats-screen');
        }

        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
            if (id === 'chats-screen') loadChats();
            if (id === 'profile-screen') loadProfile();
        }

        document.getElementById('login-btn').onclick = function() {
            let nick = document.getElementById('login-nick').value.trim();
            let pass = document.getElementById('login-pass').value.trim();
            if (!nick || !pass) { alert('Заполни оба поля'); return; }
            database.ref('users/' + nick).once('value').then(snapshot => {
                if (snapshot.exists()) {
                    if (snapshot.val().pass === pass) {
                        currentUser = { nick: nick, pass: pass, avatar: snapshot.val().avatar || '' };
                        localStorage.setItem('currentUser', JSON.stringify(currentUser));
                        showScreen('chats-screen');
                    } else { alert('Неверный пароль'); }
                } else {
                    database.ref('users/' + nick).set({ pass: pass, avatar: '' });
                    currentUser = { nick: nick, pass: pass, avatar: '' };
                    localStorage.setItem('currentUser', JSON.stringify(currentUser));
                    showScreen('chats-screen');
                }
            });
        };

        document.getElementById('logout-btn').onclick = function() {
            currentUser = null;
            localStorage.removeItem('currentUser');
            showScreen('login-screen');
        };

        document.getElementById('to-profile-btn').onclick = () => showScreen('profile-screen');
        document.getElementById('profile-back-btn').onclick = () => showScreen('chats-screen');
        document.getElementById('back-btn').onclick = () => showScreen('chats-screen');

        function loadProfile() {
            if (!currentUser) return;
            document.getElementById('profile-nick').textContent = currentUser.nick;
            document.getElementById('new-nick').value = currentUser.nick;
            document.getElementById('avatar-img').src = currentUser.avatar || '';
        }

        document.getElementById('save-nick-btn').onclick = function() {
            let newNick = document.getElementById('new-nick').value.trim();
            if (!newNick || newNick === currentUser.nick) return;
            database.ref('users/' + currentUser.nick).once('value').then(s => {
                let data = s.val();
                database.ref('users/' + newNick).set({ pass: data.pass, avatar: data.avatar || '' });
                database.ref('users/' + currentUser.nick).remove();
                currentUser.nick = newNick;
                localStorage.setItem('currentUser', JSON.stringify(currentUser));
                alert('Ник изменён!');
                loadProfile();
            });
        };

        document.getElementById('avatar-file').onchange = function() {
            let file = this.files[0];
            if (!file) return;
            let reader = new FileReader();
            reader.onload = function(e) {
                let base64 = e.target.result;
                currentUser.avatar = base64;
                localStorage.setItem('currentUser', JSON.stringify(currentUser));
                document.getElementById('avatar-img').src = base64;
                database.ref('users/' + currentUser.nick).update({ avatar: base64 });
            };
            reader.readAsDataURL(file);
        };

        function loadChats() {
            database.ref('chats').on('value', snapshot => {
                let list = document.getElementById('chats-list');
                list.innerHTML = '';
                if (!snapshot.exists()) {
                    list.innerHTML = '<p style="color:var(--sub);text-align:center;padding:20px;">Нет чатов. Создай первый!</p>';
                    return;
                }
                snapshot.forEach(child => {
                    let chat = child.val();
                    let div = document.createElement('div');
                    div.classList.add('chat-item');
                    div.innerHTML = '<span class="icon">💬</span><span class="name">' + chat.name + '</span>';
                    div.onclick = () => openChat(child.key, chat.name);
                    list.appendChild(div);
                });
            });
        }

        document.getElementById('join-chat-btn').onclick = function() {
            let name = document.getElementById('new-chat-name').value.trim();
            if (!name) return;
            let chatId = name.replace(/\s+/g, '-').toLowerCase();
            database.ref('chats/' + chatId).set({ name: name });
            document.getElementById('new-chat-name').value = '';
            openChat(chatId, name);
        };

        function openChat(chatId, chatName) {
            currentChatId = chatId;
            document.getElementById('chat-room-title').textContent = chatName;
            document.getElementById('messages').innerHTML = '';
            replyTo = null;
            document.getElementById('reply-bar').style.display = 'none';
            showScreen('chat-room-screen');
            loadRoomMessages(chatId);
        }

        function loadRoomMessages(chatId) {
            let msgDiv = document.getElementById('messages');
            msgDiv.innerHTML = '';
            database.ref('messages/' + chatId).off();
            database.ref('messages/' + chatId).on('child_added', function(data) {
                let msg = data.val();
                let row = document.createElement('div');
                row.classList.add('message-row');
                row.setAttribute('data-id', data.key);

                let html = '<img class="msg-avatar" src="' + (msg.avatar || '') + '" alt=""><div class="message">';
                if (msg.replyTo) {
                    html += '<div class="reply-preview">↪ ' + (msg.replySender || '') + ': ' + (msg.replyText || '') + '</div>';
                }
                html += '<span class="sender">' + (msg.sender || 'Аноним') + '</span><br>' + (msg.text || '');
                if (msg.photo) {
                    html += '<br><img src="' + msg.photo + '" onclick="openImage(\'' + msg.photo + '\')">';
                }
                html += '</div>';

                row.innerHTML = html;
                row.onclick = function() {
                    replyTo = { id: data.key, text: msg.text || 'Фото', sender: msg.sender, photo: msg.photo };
                    document.getElementById('reply-text').textContent = '↩ ' + msg.sender + ': ' + (msg.text || 'Фото');
                    document.getElementById('reply-bar').style.display = 'flex';
                };
                msgDiv.appendChild(row);
                msgDiv.scrollTop = msgDiv.scrollHeight;
            });
        }

        window.openImage = function(src) {
            let win = window.open('', '_blank');
            win.document.write('<img src="' + src + '" style="max-width:100%;cursor:zoom-out;" onclick="window.close()">');
        };

        document.getElementById('cancel-reply-btn').onclick = function() {
            replyTo = null;
            document.getElementById('reply-bar').style.display = 'none';
        };

        document.getElementById('attach-btn').onclick = function() {
            document.getElementById('photo-input').click();
        };

        document.getElementById('photo-input').onchange = function() {
            let file = this.files[0];
            if (!file) return;
            let reader = new FileReader();
            reader.onload = function(e) {
                let photo = e.target.result;
                let msgData = {
                    photo: photo,
                    text: '',
                    sender: currentUser.nick,
                    avatar: currentUser.avatar || '',
                    time: Date.now()
                };
                if (replyTo) {
                    msgData.replyTo = replyTo.id;
                    msgData.replyText = replyTo.text || 'Фото';
                    msgData.replySender = replyTo.sender;
                    replyTo = null;
                    document.getElementById('reply-bar').style.display = 'none';
                }
                database.ref('messages/' + currentChatId).push(msgData);
            };
            reader.readAsDataURL(file);
            this.value = '';
        };

        document.getElementById('send-btn').onclick = function() {
            let text = document.getElementById('msg-input').value.trim();
            if (!text || !currentUser || !currentChatId) return;
            let msgData = {
                text: text,
                sender: currentUser.nick,
                avatar: currentUser.avatar || '',
                time: Date.now()
            };
            if (replyTo) {
                msgData.replyTo = replyTo.id;
                msgData.replyText = replyTo.text || 'Фото';
                msgData.replySender = replyTo.sender;
                replyTo = null;
                document.getElementById('reply-bar').style.display = 'none';
            }
            database.ref('messages/' + currentChatId).push(msgData);
            document.getElementById('msg-input').value = '';
        };
    </script>
</body>
</html>
